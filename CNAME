  document.addEventListener('keydown',function(e){if(e.key==='Escape')cl();});
})();
</script>

<script>
var answers = {};

function selectOpt(el) {
  var group = el.closest('.sc-options');
  group.querySelectorAll('.sc-opt').forEach(function(o) { o.classList.remove('selected'); });
  el.classList.add('selected');
}
document.querySelectorAll('.sc-opt').forEach(function(opt) {
  opt.addEventListener('click', function() { selectOpt(opt); });
});

function getSectionAnswers(section) {
  var map = {1:[1,2,3],2:[4,5,6],3:[7,8,9],4:[10,11],5:[12,13,14,15]};
  var qs = map[section];
  for (var i=0; i<qs.length; i++) {
    var el = document.querySelector('input[name="q'+qs[i]+'"]:checked');
    if (!el) return false;
    answers['q'+qs[i]] = parseInt(el.value);
  }
  return true;
}

function nextSection(from, to) {
  if (!getSectionAnswers(from)) {
    alert('Please answer all questions in this section before continuing.');
    return;
  }
  document.getElementById('s'+from).classList.remove('active');
  document.getElementById('s'+to).classList.add('active');
  updateProgress(to);
  window.scrollTo({top:0,behavior:'smooth'});
}
function prevSection(from, to) {
  document.getElementById('s'+from).classList.remove('active');
  document.getElementById('s'+to).classList.add('active');
  updateProgress(to);
  window.scrollTo({top:0,behavior:'smooth'});
}
function updateProgress(section) {
  var pct = (section/5)*100;
  document.getElementById('sc-bar').style.width = pct + '%';
  var labels = {'1':'Section 1 of 5','2':'Section 2 of 5','3':'Section 3 of 5','4':'Section 4 of 5','5':'Section 5 of 5'};
  var qs = {'1':'Questions 1-3','2':'Questions 4-6','3':'Questions 7-9','4':'Questions 10-11','5':'Questions 12-15'};
  document.getElementById('sc-prog-label').textContent = labels[section];
  document.getElementById('sc-prog-q').textContent = qs[section];
}

var FRICTION_DATA = [
  {q:'q1',t:'No Pipeline Accountability',d:'Marketing has no defined pipeline target. Without a number to own, marketing optimizes for activity (leads, clicks) rather than outcomes (pipeline, revenue).',sev:'red'},
  {q:'q2',t:'No Win-Loss Learning Loop',d:'Lost deals are not reviewed jointly. Marketing keeps investing in strategies that might be contributing to losses without knowing it.',sev:'red'},
  {q:'q3',t:'Vanity Metrics Drive Marketing Decisions',d:'Marketing is measured on leads and traffic, not pipeline. This creates misaligned incentives and erodes sales trust in marketing-generated leads.',sev:'red'},
  {q:'q4',t:'No Shared MQL Definition',d:'Without a joint definition of a qualified lead, sales rejects leads and marketing generates the wrong ones. This is the most common single cause of sales-marketing conflict.',sev:'red'},
  {q:'q5',t:'Leads Lack Context',d:'Sales receives bare contact info. Without behavioral context, every lead requires a cold outreach with no personalization advantage.',sev:'amber'},
  {q:'q6',t:'Lead Follow-Up SLA Missing',d:'Marketing-generated leads sit in the CRM without follow-up. The fastest-responding company wins most B2B deals. No SLA means lost pipeline.',sev:'red'},
  {q:'q7',t:'No Regular Joint Cadence',d:'Without a structured meeting, both teams optimize in isolation. Issues are only surfaced when there is already a crisis.',sev:'amber'},
  {q:'q8',t:'Sales Not Using Marketing Content',d:'If sales creates their own decks and emails, marketing is producing content for no audience. This is a classic misalignment signal.',sev:'amber'},
  {q:'q9',t:'Objection Blindness',d:'Marketing does not know what objections sales faces. Content is being created in a vacuum rather than to overcome real barriers to purchase.',sev:'amber'},
  {q:'q10',t:'Technology Silos',d:'Disconnected systems mean both teams are working from different data. Attribution is impossible and leads fall through the cracks.',sev:'red'},
  {q:'q11',t:'Marketing Lacks Pipeline Visibility',d:'Marketing cannot see the outcomes of the leads they generate. Without this feedback loop, improvement is impossible.',sev:'amber'},
  {q:'q12',t:'Disconnected Annual Planning',d:'Marketing builds its plan without sales input. The result is campaigns that generate the wrong leads for the segments sales is actually pursuing.',sev:'red'},
  {q:'q13',t:'Marketing Excluded from Launch Planning',d:'Being brought in after launch means marketing campaigns lag product or market initiatives by weeks or months.',sev:'amber'},
  {q:'q14',t:'Misaligned ICP',d:'When sales and marketing are targeting different customers, every campaign is partially wasted and pipeline quality suffers.',sev:'red'},
  {q:'q15',t:'Budget Not Tied to Pipeline Performance',d:'Allocating marketing budget without sales input means spending is not concentrated on the channels that actually produce closeable opportunities.',sev:'amber'}
];

var RECS = {
  critical:[
    'Define a joint MQL within the next 30 days - have both the VP Sales and marketing lead in the same room to agree on criteria',
    'Establish a weekly 30-minute sales-marketing sync starting immediately',
    'Give marketing read access to the CRM pipeline this week - no budget required',
    'Set marketing a pipeline contribution target for next quarter and report on it monthly',
    'Conduct a joint win-loss review on the last 5 lost deals before next month'
  ],
  developing:[
    'Document your MQL definition and get written agreement from sales leadership',
    'Implement a lead follow-up SLA and track compliance in your CRM',
    'Create a monthly pipeline review meeting between marketing and sales leaders',
    'Audit which marketing content sales is actually using - eliminate what they are not',
    'Connect your marketing automation to your CRM if not already done'
  ],
  mostly:[
    'Move from monthly to weekly pipeline reviews to close the feedback loop faster',
    'Build a live marketing attribution dashboard visible to both teams',
    'Co-create next quarter budget allocation with sales input on productive channels',
    'Formalize objection-based content creation using real sales call data'
  ],
  strong:[
    'Implement blended attribution to connect marketing touchpoints to specific closed revenue',
    'Create joint quarterly business reviews with shared revenue accountability',
    'Establish a formal ICP review process using win-loss data updated each quarter'
  ]
};

function showResults() {
  if (!getSectionAnswers(5)) {
    alert('Please answer all questions before submitting.');
    return;
  }
  var total = 0;
  for (var k in answers) total += answers[k];
  var pct = Math.round((total/45)*100);

  document.getElementById('sc-quiz').style.display = 'none';
  document.getElementById('sc-prog-wrap').style.display = 'none';
  document.getElementById('sc-results').style.display = 'block';
  window.scrollTo({top:0,behavior:'smooth'});

  // Animate gauge
  var circumference = 427;
  var offset = circumference - (pct/100)*circumference;
  setTimeout(function() {
    document.getElementById('gauge-arc').style.transition = 'stroke-dashoffset 1.2s ease';
    document.getElementById('gauge-arc').style.strokeDashoffset = offset;
  }, 100);
  var countEl = document.getElementById('res-score');
  var start = 0, end = pct, dur = 1200;
  var step = (end-start)/(dur/16);
  var cur = start;
  var timer = setInterval(function() {
    cur = Math.min(cur+step, end);
    countEl.textContent = Math.round(cur);
    if (cur >= end) clearInterval(timer);
  }, 16);

  // Stage
  var stage, desc, grade, color;
  if (pct <= 30) {
    stage='Critical Misalignment'; grade='GRADE: F'; color='#ef4444';
    desc='Sales and marketing are operating as separate departments with minimal shared accountability. Revenue is being lost at every stage of the funnel - from the wrong leads being generated to deals being lost to competitors who brief their sales teams better.';
  } else if (pct <= 50) {
    stage='Developing Alignment'; grade='GRADE: D-C'; color='#f59e0b';
    desc='Some alignment exists but it is informal and inconsistent. Good months depend on individual effort rather than systematic process. The gap between what marketing generates and what sales closes is wide and growing.';
  } else if (pct <= 70) {
    stage='Mostly Aligned'; grade='GRADE: B'; color='#60a5fa';
    desc='The foundation is in place and both teams understand their shared purpose. The gaps that remain are in measurement, closed-loop feedback, and technology - areas that, when fixed, will compound performance significantly.';
  } else if (pct <= 85) {
    stage='Strong Alignment'; grade='GRADE: A'; color='#a3e635';
    desc='Your sales and marketing function is better integrated than most $5M-$100M B2B companies. The remaining opportunity is in attribution sophistication and making alignment systematic rather than relationship-dependent.';
  } else {
    stage='Optimized Alignment'; grade='GRADE: A+'; color='#10B981';
    desc='Your revenue team operates as a genuine unified function. Shared metrics, connected technology, and joint planning have created a compounding growth advantage. The focus now is maintaining this as the company scales.';
  }
  document.getElementById('res-grade').textContent = grade;
  document.getElementById('res-grade').style.color = color;
  document.getElementById('res-stage').textContent = stage;
  document.getElementById('res-desc').textContent = desc;
  document.getElementById('gauge-arc').style.stroke = color;

  // Friction points (show lowest scoring ones)
  var scored = FRICTION_DATA.map(function(f) {
    return {...f, score: answers[f.q] || 0};
  }).filter(function(f) { return f.score <= 1; })
    .sort(function(a,b) { return a.score-b.score; })
    .slice(0,5);
  var fl = document.getElementById('res-friction-list');
  fl.innerHTML = '';
  if (scored.length === 0) {
    fl.innerHTML = '<p style="color:#64748B;font-size:14px;padding:12px 0;">No critical friction points identified. Your alignment is strong across all dimensions.</p>';
  } else {
    scored.forEach(function(f) {
      fl.innerHTML += '<div class="sc-friction-item"><div class="sc-friction-dot '+f.sev+'"></div><div class="sc-friction-text"><h4>'+f.t+'</h4><p>'+f.d+'</p></div></div>';
    });
  }

  // Recommendations
  var recKey = pct<=30?'critical':pct<=50?'developing':pct<=70?'mostly':'strong';
  var rl = document.getElementById('res-recs-list');
  rl.innerHTML = '';
  RECS[recKey].forEach(function(r) {
    rl.innerHTML += '<li>'+r+'</li>';
  });
}

function restartQuiz() {
  answers = {};
  document.querySelectorAll('input[type=radio]').forEach(function(r) { r.checked=false; });
  document.querySelectorAll('.sc-opt').forEach(function(o) { o.classList.remove('selected'); });
  document.getElementById('sc-results').style.display='none';
  document.getElementById('sc-prog-wrap').style.display='block';
  document.getElementById('sc-quiz').style.display='block';
  for(var i=1;i<=5;i++) document.getElementById('s'+i).classList.remove('active');
  document.getElementById('s1').classList.add('active');
  updateProgress(1);
  document.getElementById('sc-bar').style.width='20%';
  document.getElementById('gauge-arc').style.transition='none';
  document.getElementById('gauge-arc').style.strokeDashoffset='427';
  window.scrollTo({top:0,behavior:'smooth'});
}
</script>
</body></html>