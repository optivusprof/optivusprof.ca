<style>
:root{--ink:#0F172A;--ink2:#1E2937;--g:#10B981;--g2:#34D399;--pale:#D1FAE5;--rule:#E2E8F0;--muted:#64748B;--body:#334155;--ff:'Aptos','Inter',system-ui,sans-serif;--ffd:'Aptos Display','Aptos','Inter',system-ui,sans-serif;}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:var(--ff);background:#F8FFFE;color:var(--body);-webkit-font-smoothing:antialiased;line-height:1.7;}

/* HERO */
.sc-hero{background:var(--ink);padding:72px 0 60px;border-bottom:3px solid var(--g);}
.sc-hero-inner{max-width:800px;margin:0 auto;padding:0 40px;}
.sc-eyebrow{font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--g2);margin-bottom:12px;}
.sc-hero h1{font-family:var(--ffd);font-size:clamp(28px,5vw,50px);font-weight:800;color:#fff;line-height:1.08;margin-bottom:14px;letter-spacing:-.02em;}
.sc-hero h1 span{color:var(--g2);}
.sc-hero p{font-size:16px;color:rgba(255,255,255,.68);max-width:560px;line-height:1.72;margin-bottom:28px;}
.sc-meta{display:flex;gap:24px;flex-wrap:wrap;}
.sc-meta span{font-size:12px;color:rgba(255,255,255,.45);display:flex;align-items:center;gap:6px;}
.sc-meta strong{color:var(--g2);font-weight:600;}

/* PROGRESS */
.sc-progress-wrap{max-width:800px;margin:0 auto;padding:24px 40px 0;}
.sc-progress-bar-bg{height:4px;background:#E2E8F0;border-radius:2px;overflow:hidden;margin-bottom:6px;}
.sc-progress-bar{height:100%;background:var(--g);border-radius:2px;transition:width .4s ease;}
.sc-progress-label{font-size:12px;color:var(--muted);display:flex;justify-content:space-between;}

/* QUIZ SHELL */
.sc-shell{max-width:800px;margin:0 auto;padding:32px 40px 80px;}

/* SECTION HEADER */
.sc-section-hd{background:var(--ink);border-radius:10px 10px 0 0;padding:18px 24px;margin-top:32px;}
.sc-section-hd p{font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--g2);margin-bottom:4px;}
.sc-section-hd h2{font-family:var(--ffd);font-size:18px;font-weight:700;color:#fff;}

/* QUESTION CARD */
.sc-q{background:#fff;border:1px solid var(--rule);border-top:none;padding:24px;transition:background .2s;}
.sc-q:last-of-type{border-radius:0 0 10px 10px;margin-bottom:0;}
.sc-q-num{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:6px;}
.sc-q h3{font-size:15px;font-weight:600;color:var(--ink);margin-bottom:14px;line-height:1.45;}
.sc-options{display:flex;flex-direction:column;gap:8px;}
.sc-opt{display:flex;align-items:flex-start;gap:10px;padding:10px 14px;border:1.5px solid var(--rule);border-radius:7px;cursor:pointer;transition:all .18s;}
.sc-opt:hover{border-color:var(--g);background:rgba(16,185,129,.04);}
.sc-opt.selected{border-color:var(--g);background:rgba(16,185,129,.08);}
.sc-opt input{margin-top:3px;flex-shrink:0;accent-color:var(--g);width:16px;height:16px;}
.sc-opt-score{font-size:10px;font-weight:700;color:var(--muted);margin-left:auto;white-space:nowrap;padding-left:8px;}
.sc-opt.selected .sc-opt-score{color:var(--g);}
.sc-opt-text{font-size:14px;color:var(--body);line-height:1.5;flex:1;}

/* NAV BUTTONS */
.sc-nav{display:flex;justify-content:space-between;align-items:center;margin-top:32px;padding-top:24px;border-top:1px solid var(--rule);}
.sc-btn{display:inline-flex;align-items:center;gap:8px;padding:13px 24px;border-radius:7px;font-size:13px;font-weight:700;letter-spacing:.04em;cursor:pointer;border:none;transition:all .2s;}
.sc-btn-back{background:#fff;border:1.5px solid var(--rule);color:var(--muted);}
.sc-btn-back:hover{border-color:var(--ink);color:var(--ink);}
.sc-btn-next{background:var(--g);color:#fff;}
.sc-btn-next:hover{background:#059669;}
.sc-btn-next:disabled{background:#94A3B8;cursor:not-allowed;}
.sc-btn-submit{background:var(--ink);color:#fff;}
.sc-btn-submit:hover{background:var(--ink2);}

/* RESULTS */
#sc-results{display:none;max-width:800px;margin:0 auto;padding:32px 40px 80px;}
.sc-score-card{background:var(--ink);border-radius:16px;padding:48px 40px;text-align:center;margin-bottom:32px;}
.sc-gauge{position:relative;width:160px;height:160px;margin:0 auto 24px;}
.sc-gauge svg{transform:rotate(-90deg);}
.sc-gauge-num{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
.sc-gauge-num .num{font-family:var(--ffd);font-size:42px;font-weight:800;color:#fff;line-height:1;}
.sc-gauge-num .lbl{font-size:11px;color:rgba(255,255,255,.45);text-transform:uppercase;letter-spacing:.1em;margin-top:2px;}
.sc-grade{font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;margin-bottom:8px;}
.sc-stage{font-family:var(--ffd);font-size:28px;font-weight:800;color:#fff;margin-bottom:10px;}
.sc-stage-desc{font-size:15px;color:rgba(255,255,255,.65);max-width:480px;margin:0 auto;line-height:1.65;}

/* FRICTION POINTS */
.sc-friction{background:#fff;border:1px solid var(--rule);border-radius:12px;padding:28px;margin-bottom:20px;}
.sc-friction h3{font-family:var(--ffd);font-size:18px;font-weight:700;color:var(--ink);margin-bottom:16px;display:flex;align-items:center;gap:8px;}
.sc-friction-item{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--rule);}
.sc-friction-item:last-child{border-bottom:none;}
.sc-friction-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;margin-top:5px;}
.sc-friction-dot.red{background:#ef4444;}
.sc-friction-dot.amber{background:#f59e0b;}
.sc-friction-dot.green{background:var(--g);}
.sc-friction-text h4{font-size:14px;font-weight:600;color:var(--ink);margin-bottom:2px;}
.sc-friction-text p{font-size:13px;color:var(--muted);line-height:1.55;}

/* RECOMMENDATIONS */
.sc-recs{background:rgba(16,185,129,.06);border:1px solid rgba(16,185,129,.2);border-radius:12px;padding:28px;margin-bottom:24px;}
.sc-recs h3{font-family:var(--ffd);font-size:18px;font-weight:700;color:var(--ink);margin-bottom:14px;}
.sc-recs ul{padding-left:0;list-style:none;}
.sc-recs li{font-size:14px;color:var(--body);line-height:1.6;margin-bottom:10px;padding-left:20px;position:relative;}
.sc-recs li::before{content:'✓';position:absolute;left:0;color:var(--g);font-weight:700;}

.sc-cta-box{background:var(--ink);border-radius:12px;padding:32px;text-align:center;}
.sc-cta-box h3{font-family:var(--ffd);font-size:22px;font-weight:700;color:#fff;margin-bottom:8px;}
.sc-cta-box p{font-size:14px;color:rgba(255,255,255,.65);margin-bottom:20px;line-height:1.65;}
.sc-cta-btn{display:inline-flex;align-items:center;gap:8px;background:var(--g);color:#fff;font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:14px 28px;border-radius:7px;text-decoration:none;transition:background .2s;}
.sc-cta-btn:hover{background:#059669;}
.sc-restart{display:inline-block;margin-top:12px;font-size:13px;color:var(--muted);text-decoration:none;cursor:pointer;}
.sc-restart:hover{color:var(--g);}

/* HIDDEN */
.sc-section{display:none;}
.sc-section.active{display:block;}
#sc-quiz{display:block;}

/* FOOTER */
footer{background:#0F172A;border-top:1px solid rgba(52,211,153,.1);}
.footer-body{max-width:1160px;margin:0 auto;display:grid;grid-template-columns:1fr 260px;gap:60px;padding:48px 80px 40px;border-bottom:1px solid rgba(52,211,153,.07);}
.foot-brand{font-family:'Aptos Display','Aptos','Inter',system-ui,sans-serif;font-size:26px;font-weight:700;color:#fff;margin-bottom:6px;}
.foot-brand span{color:#34D399;}
.foot-sub{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:14px;}
.foot-desc{font-size:13px;line-height:1.7;color:rgba(255,255,255,.55);max-width:320px;margin-bottom:18px;}
.footer-social{display:flex;gap:8px;}
.footer-social a{width:32px;height:32px;border-radius:6px;background:rgba(52,211,153,.08);border:1px solid rgba(52,211,153,.18);display:inline-flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;font-size:11px;font-weight:700;}
.footer-col-nav{padding-top:44px;}
.footer-col-heading{font-size:11px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:#fff;margin-bottom:14px;}
.footer-col-links{list-style:none;padding:0;margin:0;}
.footer-col-links li{margin-bottom:9px;}
.footer-col-links a{font-size:13px;color:rgba(255,255,255,.65);text-decoration:none;transition:color .2s;}
.footer-col-links a:hover{color:#34D399;}
.footer-bottom{max-width:1160px;margin:0 auto;padding:14px 80px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;}
.footer-bottom p{font-size:11px;color:#fff;}

